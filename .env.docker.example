# Example overrides when running Mafunzo in Docker (Phase 1).
# Copy values into the server .env — do not commit real secrets.

# App still uses your existing host Postgres:
DOCKER_DB_HOST=host.docker.internal
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=mafunzo
DB_USERNAME=mafunzo_user
DB_PASSWORD=change-me

# Safe test port (host nginx keeps :80)
DOCKER_HTTP_PORT=8080

# Set true only when you intentionally want migrate on container start
RUN_MIGRATIONS=false
CACHE_CONFIG=true

APP_ENV=production
APP_DEBUG=false
APP_URL=http://41.59.85.9:8080
